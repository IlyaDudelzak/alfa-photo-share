# Налаштування для FastAPI
DEBUG=True
ADMIN_PASSWORD=admin
ADMIN_FULLNAME="Admin User Ampss"
ADMIN_AGE=30
ADMIN_GENDER=Gender.M
ADMIN_EMAIL="admin@example.com"
ADMIN_IMG_PROFILE="https://t3.ftcdn.net/jpg/00/65/75/68/240_F_65756860_GUZwzOKNMUU3HldFoIA44qss7ZIrCG8I.jpg"

# Налаштування Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# JWT налаштування
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Параметри підключення до бази даних
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=system_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Налаштування запуску
APP_HOST=0.0.0.0
APP_PORT=8000
